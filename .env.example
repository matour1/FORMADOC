APP_NAME=FORMADOC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=formadoc_v1
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="formadoc@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FORMADOC Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=3
PROJECT_OWNER_EMAIL=owner@formadoc.dev

# OpenRouter (routage IA multi-modèles) — clé serveur uniquement, jamais exposée
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_BASE=180
OPENROUTER_TIMEOUT_PER_CHAR=0.008
OPENROUTER_TIMEOUT_MIN=120
OPENROUTER_TIMEOUT_MAX=600
OPENROUTER_MAX_RETRIES=2
# Taux de conversion USD → FCFA (hypothèse : 1 crédit = 1 FCFA)
OPENROUTER_RATE_FCFA_PER_USD=620

# --- Chat IA : réglages en deux volets (« chat » et « argent ») ---
# Volet « chat » — comportement de la conversation
# CHAT_MODE : mode d'exécution des outils (auto | chat | agent).
#   agent → (DÉFAUT) outils OBLIGATOIRES (tool_choice: required) + exécution
#           automatique — comportement invisible, aucun sélecteur dans l'UI ;
#   auto  → le modèle décide ; chat → conversation pure (pas d'outils).
CHAT_MODE=agent
# Compression du contexte : historique borné en messages ET en caractères,
# contenu des pièces jointes borné (économie de crédits sur longues conversations)
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_MAX_CHARS=12000
CHAT_ATTACHMENT_MAX_CHARS=8000
# Volet « argent » — coûts et facturation en crédits
CHAT_ATTACHMENT_COST_CREDITS=1
# Ajustement du coût réel : rembourser la différence si coût réel < estimation,
# et absorber un dépassement (jamais de débit supplémentaire)
CHAT_ADJUST_TO_ACTUAL=true
CHAT_OVERSHOOT_ABSORBED=true
# Mode agent : borne la boucle d'outils (anti boucle infinie) + tool_choice requis
CHAT_TOOL_LOOP_MAX_TURNS=5
CHAT_TOOL_CHOICE_REQUIRED=true

# Anthropic (Skills documentaires Claude — expérimental, réservé aux abonnés Pro)
# Clé serveur uniquement, jamais exposée. Laisser vide pour désactiver.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
# Multiplicateur de coût (×2 : infrastructure + marge 40-60 %)
ANTHROPIC_CREDIT_MULTIPLIER=2.0

# KPay (paiements mobile money / carte) — mode test : préfixe kpay_test_ / sk_test_
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_BASE_URL=https://admin.kpay.site/api/v1
KPAY_MIN_AMOUNT=500
KPAY_CURRENCY=XAF
KPAY_DEFAULT_PAYMENT_METHOD=gateway

# Devises acceptées (Q5b : multi-devises) — première = devise par défaut
# BILLING_CURRENCIES=XAF,EUR,USD
# Taux de change (1 unité = X FCFA) pour conversion d'affichage
BILLING_RATE_EUR=655.957
BILLING_RATE_USD=620

# Renouvellement automatique des abonnements (Q1a)
# SUBSCRIPTION_AUTO_RENEW=true
# Jours avant expiration où lancer le renouvellement KPay
SUBSCRIPTION_RENEW_DAYS_BEFORE=3
# Jours de grâce après échec de paiement avant passage expired
SUBSCRIPTION_GRACE_DAYS=5

# Factures PDF (Q3a) — répertoire de stockage
# INVOICE_STORAGE_DISK=local

# Skills documentaires (docx/xlsx/pptx/pdf) : accessibles aux plans payants (Q4)
# et aux non-abonnés via crédits majorés ×1,5
# SKILLS_MIN_PLAN=standard
# SKILLS_NO_SUBSCRIPTION_MULTIPLIER=1.5

# --- Détection de structure : timeout adaptatif DeepSeek ---
# Facteur de timeout (secondes par caractère) et bornes min/max
DEEPSEEK_TIMEOUT_PER_CHAR=0.008
DEEPSEEK_TIMEOUT_BASE=30
DEEPSEEK_TIMEOUT_MIN=30
DEEPSEEK_TIMEOUT_MAX=300
# Délai avant nouvelle tentative (secondes) et nombre max de tokens en sortie
DEEPSEEK_RETRY_DELAY=1
DEEPSEEK_MAX_TOKENS=8192

# --- KPay : réglages réseau ---
KPAY_TIMEOUT=30
KPAY_RETRIES=3

# --- Facturation : devise par défaut du sélecteur ---
BILLING_DEFAULT_CURRENCY=XAF

# --- LibreOffice (aperçu PDF) ---
# Optionnel : auto-détecté dans le PATH puis les chemins standards
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com

# --- Refonte documentaire : pipeline d'ingestion (voir PLAN_REFONTE.md) ---
# DOCUMENT_PIPELINE_V2 : pipeline de traitement des documents.
#   false  → (DÉFAUT) ancien pipeline (app/DocAnalyzer, lecture PHPWord) ;
#   true   → nouveau pipeline (app/Document, parseur OOXML natif) ;
#   auto   → nouveau pipeline avec REPLI automatique sur l'ancien en cas
#            d'échec (recommandé pendant la transition).
DOCUMENT_PIPELINE_V2=false
# Écrire le JSON structurel en base EN PLUS du format historique
# (les deux coexistent : l'ancien n'est jamais supprimé avant validation).
DOCUMENT_PERSIST_STRUCTURAL=true
# Seuil de confiance sous lequel un bloc déclenche une clarification ciblée.
DOCUMENT_CONFIDENCE_THRESHOLD=0.85
# Plafond de dépense IA pour la classification (double garde-fou : par
# document et global mensuel). Au dépassement : mode 100 % déterministe.
DOCUMENT_CLASSIFICATION_MAX_CREDITS=5
DOCUMENT_CLASSIFICATION_GLOBAL_LIMIT_USD=50
