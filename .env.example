APP_NAME=FORMADOC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production : LOG_STACK=daily et LOG_DAILY_DAYS=14 (rotation, voir .env.production)

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=formadoc_v1
DB_USERNAME=root
DB_PASSWORD=
# utf8mb4 — NE JAMAIS remettre « utf8 » (alias de utf8mb3, 3 octets) :
# MySQL rejette alors les emojis des réponses IA
# (SQLSTATE[HY000] 1366 Incorrect string value), et le message est perdu
# APRÈS facturation des crédits.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production : SESSION_SECURE_COOKIE=true, SESSION_HTTP_ONLY=true,
# SESSION_SAME_SITE=lax (voir .env.production)
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="formadoc@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FORMADOC Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# deepseek-chat = alias NON-raisonnant de deepseek-v4-flash. Ne pas mettre
# « deepseek-v4-flash » : ce modèle brûle tout max_tokens en reasoning_content
# et renvoie un contenu vide sur les gros documents.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=3
PROJECT_OWNER_EMAIL=owner@formadoc.dev

# OpenRouter (routage IA multi-modèles) — clé serveur uniquement, jamais exposée
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_BASE=180
OPENROUTER_TIMEOUT_PER_CHAR=0.008
OPENROUTER_TIMEOUT_MIN=120
OPENROUTER_TIMEOUT_MAX=600
OPENROUTER_MAX_RETRIES=2
# Taux de conversion USD → FCFA (hypothèse : 1 crédit = 1 FCFA)
OPENROUTER_RATE_FCFA_PER_USD=620

# --- Chat IA : réglages en deux volets (« chat » et « argent ») ---
# Volet « chat » — comportement de la conversation
# CHAT_MODE : mode d'exécution des outils (auto | chat | agent).
#   agent → (DÉFAUT) outils OBLIGATOIRES (tool_choice: required) + exécution
#           automatique — comportement invisible, aucun sélecteur dans l'UI ;
#   auto  → le modèle décide ; chat → conversation pure (pas d'outils).
CHAT_MODE=agent
# Compression du contexte : historique borné en messages ET en caractères,
# contenu des pièces jointes borné (économie de crédits sur longues conversations)
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_MAX_CHARS=12000
CHAT_ATTACHMENT_MAX_CHARS=8000
# Volet « argent » — coûts et facturation en crédits
CHAT_ATTACHMENT_COST_CREDITS=1
# Ajustement du coût réel : rembourser la différence si coût réel < estimation,
# et absorber un dépassement (jamais de débit supplémentaire)
CHAT_ADJUST_TO_ACTUAL=true
CHAT_OVERSHOOT_ABSORBED=true
# Mode agent : borne la boucle d'outils (anti boucle infinie) + tool_choice requis
CHAT_TOOL_LOOP_MAX_TURNS=5
CHAT_TOOL_CHOICE_REQUIRED=true

# Anthropic (Skills documentaires Claude — expérimental, réservé aux abonnés Pro)
# Clé serveur uniquement, jamais exposée. Laisser vide pour désactiver.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
# Multiplicateur de coût (×2 : infrastructure + marge 40-60 %)
ANTHROPIC_CREDIT_MULTIPLIER=2.0

# KPay (paiements mobile money / carte) — mode test : préfixe kpay_test_ / sk_test_
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_BASE_URL=https://admin.kpay.site/api/v1
KPAY_MIN_AMOUNT=500
KPAY_CURRENCY=XAF
KPAY_DEFAULT_PAYMENT_METHOD=gateway

# --- Monetbil (paiements mobile money) ---------------------------------------
# Un service Monetbil est une OFFRE, pas une plateforme : chaque service a son
# propre identifiant, sa propre clé service et son propre secret. Il n'y a donc
# PAS un seul couple global pour tous les packs.
#
# Compatibilité legacy : couple global utilisé seulement si AUCUN service par
# pack n'est renseigné (déploiement mono-service). Le vrai schéma reste
# « un service = un couple key/secret ».
MONETBIL_SERVICE_DEFAULT_KEY=
MONETBIL_SERVICE_DEFAULT_SECRET=
#
# Identifiants par pack de recharge. Le résolveur lit ces valeurs pour signer
# l'achat du bon service, et pour vérifier la notification avec le bon secret.
# Un pack dont le service est incomplet n'est PAS proposé.
#   _PACK_1000         = identifiant du service chez Monetbil
#   _PACK_1000_KEY     = clé de signature de CE service
#   _PACK_1000_SECRET  = secret de CE service
MONETBIL_SERVICE_PACK_1000=
MONETBIL_SERVICE_PACK_1000_KEY=
MONETBIL_SERVICE_PACK_1000_SECRET=
MONETBIL_SERVICE_PACK_3000=
MONETBIL_SERVICE_PACK_3000_KEY=
MONETBIL_SERVICE_PACK_3000_SECRET=
MONETBIL_SERVICE_PACK_5000=
MONETBIL_SERVICE_PACK_5000_KEY=
MONETBIL_SERVICE_PACK_5000_SECRET=
# Devise, langue, montant minimum et reseau
MONETBIL_CURRENCY=XAF
MONETBIL_LOCALE=fr
MONETBIL_MIN_AMOUNT=500
MONETBIL_TIMEOUT=30
MONETBIL_RETRIES=3
# Methode HTTP de notification reglee COTE MONETBIL. Le formulaire Monetbil
# affiche GET par defaut ; notre route accepte GET ET POST, donc cette valeur
# ne pilote pas le routage — elle documente ce qui est configure en face.
MONETBIL_NOTIFICATION_METHOD=GET

# Devises acceptées (Q5b : multi-devises) — première = devise par défaut
# BILLING_CURRENCIES=XAF,EUR,USD
# Taux de change (1 unité = X FCFA) pour conversion d'affichage
BILLING_RATE_EUR=655.957
BILLING_RATE_USD=620

# Renouvellement automatique des abonnements (Q1a)
# SUBSCRIPTION_AUTO_RENEW=true
# Jours avant expiration où lancer le renouvellement KPay
SUBSCRIPTION_RENEW_DAYS_BEFORE=3
# Jours de grâce après échec de paiement avant passage expired
SUBSCRIPTION_GRACE_DAYS=5

# Factures PDF (Q3a) — répertoire de stockage
# INVOICE_STORAGE_DISK=local

# Skills documentaires (docx/xlsx/pptx/pdf) : accessibles aux plans payants (Q4)
# et aux non-abonnés via crédits majorés ×1,5
# SKILLS_MIN_PLAN=standard
# SKILLS_NO_SUBSCRIPTION_MULTIPLIER=1.5

# --- Détection de structure : timeout adaptatif DeepSeek ---
# Facteur de timeout (secondes par caractère) et bornes min/max
# ATTENTION : il n'existe PAS de variable DEEPSEEK_TIMEOUT globale — seules
# les quatre ci-dessous sont lues par config/deepseek.php.
DEEPSEEK_TIMEOUT_PER_CHAR=0.008
DEEPSEEK_TIMEOUT_BASE=180
DEEPSEEK_TIMEOUT_MIN=120
DEEPSEEK_TIMEOUT_MAX=600
# Délai avant nouvelle tentative (millisecondes) et budget de sortie
# 65 536 : le modèle supporte jusqu'à 384K de sortie ; en dessous (~8-16K) le
# JSON d'analyse d'un gros rapport est tronqué et devient invalide.
DEEPSEEK_RETRY_DELAY=2000
DEEPSEEK_MAX_TOKENS=65536

# --- KPay : réglages réseau ---
KPAY_TIMEOUT=30
KPAY_RETRIES=3

# --- Facturation : devise par défaut du sélecteur ---
BILLING_DEFAULT_CURRENCY=XAF

# --- LibreOffice (aperçu PDF) ---
# Optionnel : auto-détecté dans le PATH puis les chemins standards
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com

# --- Refonte documentaire : pipeline d'ingestion (voir PLAN_REFONTE.md) ---
# DOCUMENT_PIPELINE_V2 : pipeline de traitement des documents.
#   false  → (DÉFAUT) ancien pipeline (app/DocAnalyzer, lecture PHPWord) ;
#   true   → nouveau pipeline (app/Document, parseur OOXML natif) ;
#   auto   → nouveau pipeline avec REPLI automatique sur l'ancien en cas
#            d'échec (recommandé pendant la transition).
DOCUMENT_PIPELINE_V2=false
# Écrire le JSON structurel en base EN PLUS du format historique
# (les deux coexistent : l'ancien n'est jamais supprimé avant validation).
DOCUMENT_PERSIST_STRUCTURAL=true
# Seuil de confiance sous lequel un bloc déclenche une clarification ciblée.
DOCUMENT_CONFIDENCE_THRESHOLD=0.85
# Plafond de dépense IA pour la classification (double garde-fou : par
# document et global mensuel). Au dépassement : mode 100 % déterministe.
DOCUMENT_CLASSIFICATION_MAX_CREDITS=5
DOCUMENT_CLASSIFICATION_GLOBAL_LIMIT_USD=50
