APP_NAME=FORMADOC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=formadoc_v1
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="formadoc@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FORMADOC Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=3
PROJECT_OWNER_EMAIL=owner@formadoc.dev

# OpenRouter (routage IA multi-modèles) — clé serveur uniquement, jamais exposée
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_BASE=180
OPENROUTER_TIMEOUT_PER_CHAR=0.008
OPENROUTER_TIMEOUT_MIN=120
OPENROUTER_TIMEOUT_MAX=600
OPENROUTER_MAX_RETRIES=2
# Taux de conversion USD → FCFA (hypothèse : 1 crédit = 1 FCFA)
OPENROUTER_RATE_FCFA_PER_USD=620

# Anthropic (Skills documentaires Claude — expérimental, réservé aux abonnés Pro)
# Clé serveur uniquement, jamais exposée. Laisser vide pour désactiver.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
# Multiplicateur de coût (×2 : infrastructure + marge 40-60 %)
ANTHROPIC_CREDIT_MULTIPLIER=2.0

# KPay (paiements mobile money / carte) — mode test : préfixe kpay_test_ / sk_test_
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_BASE_URL=https://admin.kpay.site/api/v1
KPAY_MIN_AMOUNT=500
KPAY_CURRENCY=XAF
KPAY_DEFAULT_PAYMENT_METHOD=gateway

# Devises acceptées (Q5b : multi-devises) — première = devise par défaut
# BILLING_CURRENCIES=XAF,EUR,USD
# Taux de change (1 unité = X FCFA) pour conversion d'affichage
BILLING_RATE_EUR=655.957
BILLING_RATE_USD=620

# Renouvellement automatique des abonnements (Q1a)
# SUBSCRIPTION_AUTO_RENEW=true
# Jours avant expiration où lancer le renouvellement KPay
SUBSCRIPTION_RENEW_DAYS_BEFORE=3
# Jours de grâce après échec de paiement avant passage expired
SUBSCRIPTION_GRACE_DAYS=5

# Factures PDF (Q3a) — répertoire de stockage
# INVOICE_STORAGE_DISK=local

# Skills documentaires (docx/xlsx/pptx/pdf) : accessibles aux plans payants (Q4)
# et aux non-abonnés via crédits majorés ×1,5
# SKILLS_MIN_PLAN=standard
# SKILLS_NO_SUBSCRIPTION_MULTIPLIER=1.5
