<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Mémoire des tests.
             La suite complète (~1 290 tests) dépasse la limite PHP par défaut
             de 128 Mo et meurt sur « Premature end of PHP process » — sur un
             test qui passe pourtant isolément, ce qui envoie chercher un défaut
             inexistant.

             Le réglage est ICI et non dans une option de ligne de commande :
             `php artisan test` relance PHPUnit dans un sous-processus qui
             n'hérite pas des options `-d` du parent. Sans ces deux lignes,
             `php artisan test` échoue là où `vendor/bin/phpunit -d
             memory_limit=512M` réussit — deux commandes qui devraient être
             équivalentes. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Isolation des tests du .env local.
             Sans ces valeurs, un test lit le .env du développeur : la CI
             (Linux, .env généré depuis .env.example) et le poste local ne
             testaient donc PAS la même configuration. Concrètement, activer
             DOCUMENT_PIPELINE_V2 en local faisait échouer un test qui passait
             en CI, sans qu'aucun code n'ait changé.
             Les tests qui doivent exercer un autre pipeline le forcent
             explicitement via config(['document.pipeline.v2' => ...]). -->
        <env name="DOCUMENT_PIPELINE_V2" value="false"/>
        <env name="DOCUMENT_PERSIST_STRUCTURAL" value="true"/>
    </php>
</phpunit>
